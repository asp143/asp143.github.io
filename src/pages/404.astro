---
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
/* 404 — the OS crashed: no menubar, no taskbar (menubar={false}).
   Self-contained crash dialog on the bare desktop wallpaper; any keypress
   flips to the BSOD easter egg (skipped under prefers-reduced-motion). */
---

<BaseLayout title="404 — Page Not Found — Ralph Jonas Mungcal" noindex={true} menubar={false}>
  <main class="not-found">
    <Window
      title="error — file not found"
      app="error"
      variant="section"
      headingLevel={1}
      closeHref="/"
      class="crash-win"
    >
      <div class="crash-body">
        <span class="crash-glyph" aria-hidden="true">
          <svg viewBox="0 0 12 12" shape-rendering="crispEdges" role="presentation" focusable="false">
            <path
              fill="currentColor"
              d="M0 0h3v3H0zM9 0h3v3H9zM3 3h3v3H3zM6 3h3v3H6zM3 6h3v3H3zM6 6h3v3H6zM0 9h3v3H0zM9 9h3v3H9z"
            />
          </svg>
        </span>
        <div class="crash-text">
          <p class="not-found__shell" aria-hidden="true">
            <span class="not-found__prompt">$</span>
            <span class="not-found__cmd">cd</span>
            <span class="not-found__arg" id="nf-path">/requested/path</span>
          </p>
          <p class="not-found__error">bash: cd: <span id="nf-path-2">requested path</span>: no such file or directory</p>
          <p class="not-found__code">404</p>
          <p class="not-found__message">the page you were looking for has been unlinked, moved, or never existed.</p>
          <div class="crash-actions">
            <a href="/" class="keycap keycap--primary">[ go home ]</a>
            <button type="button" class="keycap" id="nf-back">[ go back ]</button>
          </div>
          <p class="crash-hint" aria-hidden="true">press any key to panic</p>
        </div>
      </div>
    </Window>
  </main>

  <div class="bsod" id="bsod" hidden>
    <div class="bsod-inner">
      <p class="bsod-face" aria-hidden="true">:(</p>
      <p class="bsod-message">
        ralphOS ran into a problem and needs to restart. we're just collecting
        some error info, and then you can carry on browsing.
      </p>
      <p class="bsod-code">stop code: PAGE_NOT_FOUND (0x00000404)</p>
      <p class="bsod-hint">press any key to return</p>
    </div>
  </div>

  <style is:global>
    /* Self-contained 404 styles — chrome classes (.win*, .keycap) come
       from the shared os.css; only crash-dialog layout lives here. */
    .not-found {
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 1.5rem;
    }

    .crash-win {
      width: 100%;
      max-width: 560px;
      margin-block: 0; /* override .win--section section spacing */
    }

    .crash-body {
      display: flex;
      align-items: flex-start;
      gap: clamp(0.9rem, 3vw, 1.4rem);
    }

    .crash-glyph {
      flex: none;
      width: 44px;
      height: 44px;
      display: grid;
      place-items: center;
      background: var(--color-error);
      color: var(--color-bg);
      border: var(--border-w) solid var(--color-ink);
      box-shadow: var(--shadow-hard-sm);
    }

    .crash-glyph svg {
      width: 24px;
      height: 24px;
    }

    .crash-text {
      min-width: 0;
    }

    .not-found__shell {
      font-size: 0.85rem;
      color: var(--color-ink-soft);
      margin: 0 0 0.75rem;
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
    }

    .not-found__prompt {
      color: var(--color-accent);
      font-weight: 700;
    }

    .not-found__arg {
      word-break: break-word;
    }

    .not-found__error {
      font-size: 0.8rem;
      color: var(--color-ink-muted);
      margin: 0 0 1.25rem;
      word-break: break-word;
    }

    .not-found__code {
      font-family: var(--font-pixel);
      font-size: clamp(3rem, 10vw, 5rem);
      font-weight: 700;
      margin: 0 0 0.75rem;
      color: var(--color-error);
      line-height: 1;
    }

    .not-found__message {
      font-size: 0.9rem;
      color: var(--color-ink-soft);
      line-height: 1.55;
      margin: 0 0 1.5rem;
      max-width: 50ch;
    }

    .crash-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .crash-hint {
      margin: 1.25rem 0 0;
      font: 700 10px/1.4 var(--font-pixel);
      text-transform: lowercase;
      color: var(--color-ink-muted);
      user-select: none;
    }

    @media (max-width: 479.98px) {
      .crash-glyph {
        display: none; /* tight screens: text carries the dialog */
      }
    }

    /* The BSOD never fires under reduced motion (script gate below) and
       touch-only devices have no key to press — hide the dead hint. */
    @media (prefers-reduced-motion: reduce), (hover: none) and (pointer: coarse) {
      .crash-hint {
        display: none;
      }
    }

    /* ── BSOD easter egg (any keypress; skipped under reduced motion) ── */
    .bsod {
      position: fixed;
      inset: 0;
      z-index: var(--z-dialog);
      display: grid;
      place-items: center;
      padding: 2rem;
      background: #2743c7; /* flat BSOD blue — deliberately off-palette */
      color: #fdfbf0;
      font-family: var(--font-mono);
      cursor: default;
    }

    .bsod[hidden] {
      display: none;
    }

    .bsod-inner {
      max-width: 560px;
    }

    .bsod-face {
      font-size: clamp(4rem, 12vw, 6.5rem);
      font-weight: 700;
      line-height: 1;
      margin: 0 0 1.5rem;
    }

    .bsod-message {
      font-size: 0.95rem;
      line-height: 1.65;
      margin: 0 0 1.25rem;
    }

    .bsod-code {
      font: 700 11px/1.4 var(--font-pixel);
      text-transform: lowercase;
      margin: 0 0 2rem;
      opacity: 0.8;
    }

    .bsod-hint {
      font-size: 0.85rem;
      margin: 0;
      opacity: 0.8;
    }
  </style>

  <script>
    type PostHogClient = {
      capture: (eventName: string, properties?: Record<string, string>) => void;
    };

    const path = window.location.pathname;
    const target = document.getElementById('nf-path');
    const target2 = document.getElementById('nf-path-2');
    if (target) target.textContent = path;
    if (target2) target2.textContent = path;

    const posthog = (window as Window & { posthog?: PostHogClient }).posthog;
    if (posthog) {
      posthog.capture('404_hit', {
        path,
        referrer: document.referrer,
        search: location.search
      });
    }

    // [ go back ] — history.back with home fallback
    const back = document.getElementById('nf-back');
    if (back) {
      back.addEventListener('click', () => {
        if (window.history.length > 1) {
          window.history.back();
        } else {
          window.location.href = '/';
        }
      });
    }

    // BSOD easter egg: any keypress flips; next keypress returns.
    // Skipped under reduced motion (no sudden full-screen flash). Keys
    // needed for keyboard navigation (Tab/Enter/Space/modifiers/Esc)
    // never trigger it.
    const bsod = document.getElementById('bsod');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (bsod && !reducedMotion) {
      const passthrough = ['Tab', 'Shift', 'Control', 'Alt', 'Meta', 'Escape', 'Enter', ' '];
      document.addEventListener('keydown', (ev) => {
        if (ev.metaKey || ev.ctrlKey || ev.altKey) return;
        if (bsod.hidden && passthrough.includes(ev.key)) return;
        if (!bsod.hidden && ev.key === 'Tab') return;
        ev.preventDefault();
        bsod.hidden = !bsod.hidden;
      });
    }
  </script>
</BaseLayout>
