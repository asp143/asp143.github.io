---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Window from '../components/Window.astro';
import { getPublishedPosts, formatPubDate, toIsoDate, isNewPost } from '../utils/blog';
import { otherWork, sideProjects } from '../data/projects';
import '../styles/home.css';

const currentYear = new Date().getFullYear();

const MAX_POSTS = 5;
const allPosts = await getPublishedPosts();
const blogPosts = allPosts.slice(0, MAX_POSTS).map((post) => ({
  slug: post.id,
  title: post.data.title,
  date: formatPubDate(post.data.pubDate),
  datetime: toIsoDate(post.data.pubDate),
  url: `/blog/${post.id}/`,
  isNew: isNewPost(post.data.pubDate)
}));
const newPostSlugs = blogPosts.filter((post) => post.isNew).map((post) => post.slug);

const HERO_SUBTITLE = 'full-stack developer & ai integration specialist. i build scalable, practical software — backend architecture, cloud infra, dev tooling, ai-powered workflows.';

const projectEntries = await getCollection('projects', ({ data }) => !data.draft);
const featuredProjects = projectEntries
  .filter((entry) => entry.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6)
  .map((entry) => ({
    slug: entry.id,
    name: entry.data.name,
    stack: entry.data.stack,
    tech: entry.data.tech ?? entry.data.stack.map((s) => s.toLowerCase()).join(' · '),
    description: entry.data.description,
    url: `/projects/${entry.id}/`
  }));

const featuredSideProjects = sideProjects.slice(0, 3);

const projectItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Featured Projects by Ralph Jonas Mungcal',
  itemListElement: featuredProjects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `https://ralphjonas.com${project.url}`,
    item: {
      '@type': 'CreativeWork',
      '@id': `https://ralphjonas.com${project.url}#project`,
      name: project.name,
      url: `https://ralphjonas.com${project.url}`,
      description: project.description,
      keywords: project.stack.join(', '),
      creator: { '@id': 'https://ralphjonas.com/#person' }
    }
  }))
};

const sideProjectItemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Side Projects by Ralph Jonas Mungcal',
  itemListElement: sideProjects.map((project, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'CreativeWork',
      name: project.name,
      url: project.url,
      description: project.description,
      creator: { '@id': 'https://ralphjonas.com/#person' }
    }
  }))
};
---

<BaseLayout pageType="profile" taskbar>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(projectItemList)}></script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(sideProjectItemList)}></script>
  </Fragment>

  <Fragment slot="menubar-hint">
    press <kbd>g</kbd> then <kbd>h</kbd>/<kbd>a</kbd>/<kbd>p</kbd>/<kbd>s</kbd>/<kbd>w</kbd>/<kbd>c</kbd>
  </Fragment>

  <main class="portfolio-page" data-desktop>
    <!-- ── Desktop zone ─────────────────────────────────────────────── -->
    <section class="desktop" id="hero" aria-label="ralphOS desktop">
      <!-- Hero window (floating ≥1024px + fine pointer; in-flow card otherwise) -->
      <section
        class="win win--floating hero-window"
        data-draggable
        aria-label="welcome window"
      >
        <header class="win-bar">
          <span class="win-title">readme.md — ralph jonas</span>
          <span class="win-controls">
            <button type="button" class="win-btn win-btn--close" data-close-joke aria-label="close" hidden>×</button>
          </span>
        </header>
        <div class="win-body hero-window-body">
          <div class="hero-whoami" aria-hidden="true">
            <span class="hero-whoami-prompt">$</span>
            <span>whoami</span>
            <span class="hero-whoami-flag">--verbose</span>
          </div>

          <h1 class="hero-name">
            <span class="visually-hidden">Ralph Jonas Mungcal — Full-Stack Developer & AI Integration Specialist</span>
            <span class="hero-name-line" aria-hidden="true">
              {'Ralph'.split('').map(letter => (
                <span class="hero-name-letter motion-letter">{letter}</span>
              ))}
            </span>
            <span class="hero-name-line" aria-hidden="true">
              {'Jonas'.split('').map(letter => (
                <span class="hero-name-letter motion-letter">{letter}</span>
              ))}
              <span class="hero-name-letter motion-letter hero-period">_</span>
            </span>
          </h1>

          <p class="hero-subtitle motion-fade" data-typewriter={HERO_SUBTITLE}>
            <span class="hero-subtitle-sizer" aria-hidden="true">{HERO_SUBTITLE}</span>
            <span class="hero-subtitle-typed" aria-hidden="true">
              <span class="hero-subtitle-text">{HERO_SUBTITLE}</span>
              <span class="hero-cursor"></span>
            </span>
            <span class="visually-hidden">{HERO_SUBTITLE}</span>
          </p>

          <div class="hero-tags motion-fade" aria-hidden="true">
            <span class="hero-tag">#typescript</span>
            <span class="hero-tag">#node</span>
            <span class="hero-tag">#gcp</span>
            <span class="hero-tag">#ai</span>
            <span class="hero-tag">#linux</span>
          </div>
        </div>
      </section>

      <!-- Desktop icons -->
      <nav class="desktop-icons" aria-label="desktop shortcuts">
        <a class="desktop-icon" href="#about" style="--app-tint: var(--tint-about);">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2 1h5l3 3v7H2z" fill="var(--color-surface)" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M7 1v3h3" fill="none" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M4 6h4M4 8h4" stroke="var(--color-app-about)" stroke-width="1" />
          </svg>
          <span class="desktop-icon-label">about.md</span>
        </a>
        <a class="desktop-icon" href="/projects/" style="--app-tint: var(--tint-projects);">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M1 2h4l1 1h5v7H1z" fill="var(--tint-projects)" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M1 5h10" stroke="var(--color-ink)" stroke-width="1" />
          </svg>
          <span class="desktop-icon-label">projects/</span>
        </a>
        <a class="desktop-icon" href="#side-projects" style="--app-tint: var(--tint-side);">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M1 2h4l1 1h5v7H1z" fill="var(--tint-side)" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M1 5h10" stroke="var(--color-ink)" stroke-width="1" />
          </svg>
          <span class="desktop-icon-label">side-quests/</span>
        </a>
        <a
          class="desktop-icon"
          href="#writing"
          style="--app-tint: var(--tint-writing);"
          data-new-slugs={newPostSlugs.length > 0 ? newPostSlugs.join(',') : undefined}
        >
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M1 2h4l1 1h5v7H1z" fill="var(--tint-writing)" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M1 5h10" stroke="var(--color-ink)" stroke-width="1" />
          </svg>
          <span class="desktop-icon-badge" hidden>new</span>
          <span class="desktop-icon-label">writing/</span>
        </a>
        <a class="desktop-icon desktop-icon--wiggle" href="#contact" style="--app-tint: var(--tint-contact);">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <rect x="1" y="3" width="10" height="7" fill="var(--tint-contact)" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M1 3l5 4 5-4" fill="none" stroke="var(--color-ink)" stroke-width="1" />
          </svg>
          <span class="desktop-icon-label">contact.exe</span>
        </a>
        <a class="desktop-icon" href="/now/">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M2 1h8v8l-2 2H2z" fill="var(--color-sticky)" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M8 11V9h2" fill="none" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M4 4h4M4 6h3" stroke="var(--color-ink-muted)" stroke-width="1" />
          </svg>
          <span class="desktop-icon-label">now.txt</span>
        </a>
        <button type="button" class="desktop-icon desktop-icon--trash" id="open-trash">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M3 3h6v8H3z" fill="var(--color-bg-alt)" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M2 3h8M5 1h2v2" fill="none" stroke="var(--color-ink)" stroke-width="1" />
            <path d="M5 5v4M7 5v4" stroke="var(--color-ink-muted)" stroke-width="1" />
          </svg>
          <span class="desktop-icon-label">trash</span>
        </button>
      </nav>

      <!-- Sticky note (desktop only) -->
      <aside class="sticky-note" data-draggable="self" aria-label="sticky note">
        <p class="sticky-line">TODO: touch grass</p>
        <p class="sticky-line"><a href="/now/">check ~/now</a></p>
        <p class="sticky-line sticky-sig" aria-hidden="true">– ralph</p>
      </aside>

      <div class="hero-scroll motion-fade">
        <span class="hero-scroll-flow"><span class="hero-scroll-text">scroll</span> <span class="hero-scroll-arrow" aria-hidden="true">&#8595;</span></span>
        <span class="hero-scroll-desktop">click a folder to open it</span>
      </div>
    </section>

    <!-- ── Section windows 01–05 ────────────────────────────────────── -->
    <div class="home-sections">
      <!-- 01. About -->
      <Window title="about.md — 01" headingText="About Ralph Jonas Mungcal" app="about" id="about" variant="section" headingLevel={2} collapsible>
        <p class="win-cmdline" aria-hidden="true">
          <span class="cmd-prompt">$</span> cat about.md <span class="cmd-flag">--format=plain</span>
        </p>

        <div class="about-grid">
          <div class="about-col-left">
            <span class="about-name motion-fade" aria-label="Ralph Jonas Mungcal">ralph jonas</span>
            <p class="about-bio motion-fade">
              full-stack developer and ai integration specialist based in the philippines. i build products end-to-end — from backend architecture and cloud infra to dev tooling and ai-powered workflows.
            </p>
            <p class="about-bio motion-fade">
              i focus on writing clean, maintainable systems that solve real problems. whether it's orchestrating payments across multiple gateways, building data aggregation pipelines, or self-hosting infra — details matter.
            </p>
          </div>

          <div class="about-col-right">
            <div class="about-stats">
              <div class="about-stat motion-stagger">
                <span class="about-stat-number" data-count={currentYear - 2018}>0+</span>
                <span class="about-stat-label">years shipping</span>
              </div>
              <div class="about-stat motion-stagger">
                <span class="about-stat-number" data-count="10">0+</span>
                <span class="about-stat-label">projects shipped</span>
              </div>
            </div>

            <div class="focus-list">
              <span class="focus-item motion-stagger">backend-arch</span>
              <span class="focus-item motion-stagger">ai-integration</span>
              <span class="focus-item motion-stagger">cloud-infra</span>
              <span class="focus-item motion-stagger">dev-tooling</span>
            </div>

            <div class="about-stack">
              <span class="about-stack-label motion-fade">daily-drivers</span>
              <div class="about-stack-items">
                <span class="about-stack-item motion-stagger">typescript</span>
                <span class="about-stack-item motion-stagger">node.js</span>
                <span class="about-stack-item motion-stagger">gcp</span>
                <span class="about-stack-item motion-stagger">docker</span>
                <span class="about-stack-item motion-stagger">postgres</span>
                <span class="about-stack-item motion-stagger">linux</span>
              </div>
            </div>
          </div>
        </div>
      </Window>

      <!-- 02. Projects -->
      <Window title="ls ./projects — 02" headingText="Projects" app="projects" id="projects" variant="section" headingLevel={2} collapsible>
        <p class="win-cmdline" aria-hidden="true">
          <span class="cmd-prompt">$</span> ls ./projects/ <span class="cmd-flag">-la</span>
        </p>

        <ul class="project-list" role="list">
          {featuredProjects.map((project) => (
            <li class="project-row motion-stagger">
              <a class="project-link" href={project.url} aria-label={`Open project: ${project.name}`}>
                <span class="project-name">{project.name}</span>
                <span class="project-tech">{project.tech}</span>
                <p class="project-desc">{project.description.toLowerCase()}</p>
                <span class="project-link-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>

        <h3 class="other-heading motion-fade">other-work</h3>

        <ul class="project-list other-work-list" role="list">
          {otherWork.map((item) => (
            <li class="compact-row motion-stagger">
              <span class="compact-name">{item.name}</span>
              <span class="compact-tech">{item.tech}</span>
              {item.description && <p class="compact-desc">{item.description}</p>}
            </li>
          ))}
        </ul>

        <a href="/projects/" class="keycap view-all-keycap motion-fade">
          view all projects <span aria-hidden="true">&rarr;</span>
        </a>
      </Window>

      <!-- 03. Side Projects -->
      <Window title="side-quests — 03" app="side" id="side-projects" variant="section" headingLevel={2} collapsible>
        <p class="win-cmdline" aria-hidden="true">
          <span class="cmd-prompt">$</span> cd ~/side-projects/ <span class="cmd-flag">&amp;&amp; ls</span>
        </p>

        <p class="side-project-intro motion-fade">
          showing 3 of what i'm up to right now. tap <strong>see all projects</strong> below for the full list.
        </p>

        <ul class="side-project-list" role="list">
          {featuredSideProjects.map((item) => (
            <li>
              <a href={item.url} class="side-project-row motion-stagger" target="_blank" rel="noopener noreferrer">
                <div class="side-project-info">
                  <span class="side-project-name">{item.name}</span>
                  <p class="side-project-desc">{item.description}</p>
                </div>
                <span class="side-project-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>

        <a href="/now/" class="keycap view-all-keycap motion-fade">
          see all projects <span aria-hidden="true">&rarr;</span>
        </a>
      </Window>

      <!-- 04. Writing -->
      <Window title="git log ./writing — 04" headingText="Writing" app="writing" id="writing" variant="section" headingLevel={2} collapsible>
        <p class="win-cmdline" aria-hidden="true">
          <span class="cmd-prompt">$</span> git log ./writing/ <span class="cmd-flag">--oneline -5</span>
        </p>

        <ul class="writing-list" role="list">
          {blogPosts.length > 0 ? (
            blogPosts.map((post) => (
              <li>
                <a href={post.url} class="writing-row motion-stagger">
                  <time class="writing-date" datetime={post.datetime}>{post.date}</time>
                  <span class="writing-title">
                    {post.title}
                    {post.isNew && <span class="new-badge" data-slug={post.slug} hidden>new</span>}
                  </span>
                  <span class="writing-arrow" aria-hidden="true">&rarr;</span>
                </a>
              </li>
            ))
          ) : (
            <li>
              <p class="writing-empty">posts taking a coffee break. check back soon.</p>
            </li>
          )}
        </ul>

        <a href="/blog/" class="keycap view-all-keycap motion-fade">
          view all posts <span aria-hidden="true">&rarr;</span>
        </a>
      </Window>

      <!-- 05. Contact -->
      <Window title="mail — 05" headingText="Contact" app="contact" id="contact" variant="section" headingLevel={2} collapsible>
        <p class="win-cmdline" aria-hidden="true">
          <span class="cmd-prompt">$</span> echo "let's build" <span class="cmd-flag">| mail -s hi</span>
        </p>

        <h3 class="contact-cta motion-fade">
          let's work<br />together<span class="contact-period">_</span>
        </h3>

        <dialog class="mail-modal" id="contact-modal" aria-labelledby="contact-modal-title">
          <form class="mail-composer" id="contact-form" method="POST" action="https://api.web3forms.com/submit" novalidate>
          <div class="mail-composer-bar">
            <div class="shell-bar-dots">
              <button type="button" class="shell-bar-dot shell-bar-dot--live mail-modal-close" aria-label="close compose window" title="close"></button>
              <span class="shell-bar-dot"></span>
              <span class="shell-bar-dot"></span>
            </div>
            <span class="mail-composer-title" id="contact-modal-title">compose — new-message.eml</span>
            <span class="mail-modal-hint" aria-hidden="true">[esc] close</span>
            <span class="mail-composer-mode" aria-hidden="true">-- INSERT --</span>
          </div>

          <input type="hidden" name="access_key" value="d73006a4-1984-436e-b51c-2e637168aec0" />
          <input type="hidden" name="subject" value="new message via ralphjonas.com" />
          <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="mail-field mail-field--static" aria-hidden="true">
            <span class="mail-label">to:</span>
            <span class="mail-static-value">ralph jonas &lt;localhost&gt;</span>
          </div>
          <div class="mail-field">
            <label class="mail-label" for="contact-name">from:</label>
            <input class="mail-input" id="contact-name" type="text" name="name" placeholder="your name" autocomplete="name" required />
          </div>
          <div class="mail-field">
            <label class="mail-label" for="contact-email">email:</label>
            <input class="mail-input" id="contact-email" type="email" name="email" placeholder="your email address" autocomplete="email" required />
          </div>
          <div class="mail-field mail-field--body">
            <label class="mail-label" for="contact-message">body:</label>
            <textarea class="mail-input mail-textarea" id="contact-message" name="message" rows="6" placeholder="what should we build?" required></textarea>
          </div>

          <div class="mail-actions">
            <button type="submit" class="mail-send">:wq — send</button>
            <p class="mail-status" role="status" aria-live="polite"></p>
          </div>
          </form>
        </dialog>

        <div class="contact-links">
          <button type="button" class="keycap keycap--primary contact-link contact-link--wiggle motion-stagger" id="open-contact-modal">email</button>
          <a href="https://github.com/asp143" class="keycap contact-link motion-stagger" target="_blank" rel="noopener noreferrer">github</a>
          <a href="https://www.linkedin.com/in/ralphjonasmungcal" class="keycap contact-link motion-stagger" target="_blank" rel="noopener noreferrer">linkedin</a>
          <a href="https://x.com/ralphsenpaidev" class="keycap contact-link motion-stagger" target="_blank" rel="noopener noreferrer">x</a>
          <a href="https://bsky.app/profile/ralphdev.bsky.social" class="keycap contact-link motion-stagger" target="_blank" rel="noopener noreferrer">bluesky</a>
        </div>

        <footer class="site-footer">
          <span>process exited — ralph jonas mungcal &copy; {currentYear}</span>
          <span aria-hidden="true">[ctrl+c to detach]</span>
        </footer>
      </Window>
    </div>

    <!-- Browser window (desktop mode: internal pages open here instead of navigating) -->
    <section class="win win--floating browser-win" id="browser-win" aria-label="browser window">
      <header class="win-bar">
        <span class="win-title" id="browser-title">browser</span>
        <span class="win-controls">
          <a class="win-btn" id="browser-open-tab" href="/" target="_blank" rel="noopener" aria-label="open page in new tab">&nearr;</a>
          <button type="button" class="win-btn win-btn--close" id="browser-close" aria-label="close browser">×</button>
        </span>
      </header>
      <div class="browser-toolbar" aria-hidden="true">
        <span class="browser-home">⌂</span>
        <span class="browser-address" id="browser-address">ralphjonas.com</span>
      </div>
      <iframe class="browser-frame" id="browser-frame" title="page preview"></iframe>
    </section>

    <!-- Trash (easter egg dialog) -->
    <dialog class="trash-modal" id="trash-modal" aria-labelledby="trash-modal-title" data-draggable>
      <div class="trash-win win--inverse" style="--app: var(--color-ink);">
        <header class="win-bar">
          <span class="win-title" id="trash-modal-title">trash</span>
          <span class="win-controls">
            <button type="button" class="win-btn win-btn--close trash-close" aria-label="close trash">×</button>
          </span>
        </header>
        <ul class="trash-list" role="list">
          <li class="trash-row"><span class="trash-file">jquery-portfolio-2014.zip</span><span class="trash-meta">4.2 mb</span></li>
          <li class="trash-row"><span class="trash-file">ideas-from-3am/</span><span class="trash-meta">47 items</span></li>
          <li class="trash-row"><span class="trash-file">unused-domain-names.txt</span><span class="trash-meta">12 kb</span></li>
          <li class="trash-row"><span class="trash-file">todo-before-launch.txt</span><span class="trash-meta">∞ kb</span></li>
        </ul>
        <div class="trash-actions">
          <button type="button" class="keycap" id="empty-trash">empty trash</button>
        </div>
      </div>
    </dialog>

    <!-- Keyboard Nav Toast -->
    <div class="kbd-toast" id="kbd-toast" aria-live="polite">
      <span class="kbd-toast-hint">g</span>
      <span>then</span>
      <kbd>h</kbd><kbd>a</kbd><kbd>p</kbd><kbd>s</kbd><kbd>w</kbd><kbd>c</kbd>
    </div>
  </main>

  <script>
    import '../scripts/home';
    import '../scripts/blog-badges';
    import '../scripts/contact-form';
  </script>
</BaseLayout>
